# Copy values into the production secret manager. Never commit real values.
NODE_ENV=production
PORT=5000
CLIENT_URL=https://3dipl.org
PUBLIC_BASE_URL=https://3dipl.org
CORS_ORIGINS=https://www.3dipl.org
TRUST_PROXY=true

MONGO_CORE_URI=mongodb+srv://REPLACE_ATLAS_CORE
MONGO_MARKETPLACE_URI=mongodb://REPLACE_VPS_REPLICA_SET
MARKETPLACE_DB_TARGET=vps
MONGO_MARKETPLACE_TRANSACTIONS_REQUIRED=true

JWT_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
CSRF_HMAC_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
COOKIE_SIGNATURE_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
DOWNLOAD_TOKEN_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
COOKIE_ENCRYPTION_KEY=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
ADMIN_EMAILS=REPLACE_ADMIN_EMAIL
ADMIN_2FA_REQUIRED=true
ALLOW_MEMORY_DB=false
ALLOW_DEV_LOGIN=false
ALLOW_DEV_ADMIN_LOGIN=false
THREED66_MOCK=false
# Leave empty to derive the upstream origin from each submitted 3d66 URL.
THREED66_ORIGIN=

GOOGLE_CLIENT_ID=REPLACE
GOOGLE_CLIENT_SECRET=REPLACE
GOOGLE_CALLBACK_URL=https://3dipl.org/api/auth/google/callback
GOOGLE_DRIVE_CLIENT_ID=REPLACE
GOOGLE_DRIVE_CLIENT_SECRET=REPLACE
GOOGLE_DRIVE_REFRESH_TOKEN=REPLACE
MARKETPLACE_DRIVE_ROOT_FOLDER_ID=REPLACE
SCENES_DRIVE_ROOT_FOLDER_ID=REPLACE
MARKETPLACE_UPLOAD_API_TOKEN=REPLACE_WITH_LONG_RANDOM_UPLOAD_TOOL_TOKEN
HISTORY_ARCHIVE_DRIVE_FOLDER_ID=REPLACE
DATABASE_BACKUP_DRIVE_FOLDER_ID=REPLACE_SEPARATE_BACKUP_FOLDER
MARKETPLACE_DRIVE_BACKUP_FOLDER_ID=REPLACE
SCENES_DRIVE_BACKUP_FOLDER_ID=REPLACE
BACKUP_AGE_RECIPIENT=age1REPLACE_PUBLIC_RECIPIENT
BACKUP_WORK_DIR=/var/lib/3dipl/backup-work
DATABASE_SCHEMA_VERSION=1
ATLAS_CORE_STORAGE_LIMIT_BYTES=524288000
VPS_DISK_PATH=/
MARKETPLACE_DRIVE_WRITE_ENABLED=true
MARKETPLACE_DRIVE_CHANGES_ENABLED=true
MARKETPLACE_DRIVE_RECONCILE_WORKER_ENABLED=true
MARKETPLACE_DRIVE_RECONCILE_INTERVAL_MS=2000
MARKETPLACE_DRIVE_RECONCILE_LOCK_TIMEOUT_MS=900000
MARKETPLACE_DRIVE_RECONCILE_MAX_ATTEMPTS=8
MARKETPLACE_DRIVE_RECONCILE_RETRY_BASE_SECONDS=30
MARKETPLACE_STARTUP_MIGRATIONS_ENABLED=false
MARKETPLACE_COVER_CACHE_ENABLED=true
MARKETPLACE_COVER_CACHE_DIR=/var/lib/3dipl/media/covers
MARKETPLACE_COVER_PUBLIC_BASE_URL=/media/covers
MARKETPLACE_COVER_SIZE=480
MARKETPLACE_COVER_WEBP_QUALITY=80
MARKETPLACE_COVER_WORKER_ENABLED=true
MARKETPLACE_COVER_WORKER_CONCURRENCY=4
MARKETPLACE_COVER_WORKER_INTERVAL_MS=2000
MARKETPLACE_COVER_WORKER_MAX_ATTEMPTS=8
MARKETPLACE_COVER_RETRY_BASE_SECONDS=30
MARKETPLACE_REPORT_DAILY_LIMIT=20
MARKETPLACE_SEARCH_ENGINE=meilisearch
MEILISEARCH_URL=http://meilisearch:7700
MEILI_MASTER_KEY=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
MARKETPLACE_MEILI_TIMEOUT_MS=400
MARKETPLACE_MEILI_CIRCUIT_BREAKER_MS=30000
MARKETPLACE_MEILI_ROLLOUT_PERCENT=100
MARKETPLACE_MEILI_SHADOW_ENABLED=false
MARKETPLACE_MEILI_MODEL_INDEX=marketplace_models_v3
MARKETPLACE_MEILI_SCENE_INDEX=marketplace_scenes_v3
MARKETPLACE_MEILI_CHECKPOINT_FILE=/var/lib/3dipl/backup-work/marketplace-meilisearch-v3-checkpoint.json
MARKETPLACE_SEARCH_SEMANTIC_ENABLED=true
MARKETPLACE_SEARCH_FALLBACK_LIMIT=240
MARKETPLACE_SEARCH_INDEX_INTERVAL_MS=30000
MARKETPLACE_SEARCH_INDEX_BATCH_SIZE=100
MARKETPLACE_RECOMMENDATION_WORKER_ENABLED=true
MARKETPLACE_RECOMMENDATION_WORKER_INTERVAL_MS=2000
MARKETPLACE_FEATURED_TIMEOUT_MS=180
MARKETPLACE_SEARCH_FALLBACK_MAX_TIME_MS=1000
MARKETPLACE_POPULARITY_WORKER_ENABLED=true
MARKETPLACE_POPULARITY_WORKER_INTERVAL_MS=600000
STORAGE_HEALTH_JOB_ENABLED=true
STORAGE_HEALTH_RUN_ON_START=true
STORAGE_HEALTH_INTERVAL_MS=3600000
STORAGE_ALERT_COOLDOWN_MS=21600000
STORAGE_EMERGENCY_RETENTION_ENABLED=true
STORAGE_EMERGENCY_RETENTION_BATCH_SIZE=1000

TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=REPLACE_REAL_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_REAL_SECRET_KEY
TURNSTILE_EXPECTED_HOSTNAME=3dipl.org
TURNSTILE_EXPECTED_ACTION=marketplace_download

SEPAY_ENABLED=true
SEPAY_ENV=production
SEPAY_MERCHANT_ID=REPLACE
SEPAY_SECRET_KEY=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
SEPAY_SUCCESS_URL=https://3dipl.org/topup?payment=success
SEPAY_ERROR_URL=https://3dipl.org/topup?payment=error
SEPAY_CANCEL_URL=https://3dipl.org/topup?payment=cancel

MARKETPLACE_DOWNLOAD_DELIVERY=proxy
MARKETPLACE_ALLOW_PUBLIC_DRIVE_LINKS=false
# The systemd timer runs retention at 02:30; do not run a duplicate in the web process.
HISTORY_RETENTION_JOB_ENABLED=false
HISTORY_RETENTION_BATCH_SIZE=500
PLUGIN_API_ENABLED=false
PLUGIN_RELEASE_ENABLED=false
PLUGIN_DEPLOYMENT_ENV=production
PLUGIN_QA_RISK_SECRET=
PLUGIN_JWT_SECRET=
PLUGIN_DOWNLOAD_CHALLENGE_MODE=risk
PLUGIN_DOWNLOAD_CHALLENGE_TRUST_HOURS=168
PLUGIN_RELEASE_CHANNEL=production
PLUGIN_RELEASE_VERSION=0.4.0
PLUGIN_MINIMUM_VERSION=0.2.0
PLUGIN_RELEASE_URL=https://3dipl.org/plugin-releases/3DiPL-Asset-Manager-Production-0.4.0.mzp
PLUGIN_RELEASE_SHA256=
PLUGIN_RELEASE_SIGNATURE=
PLUGIN_RELEASE_PUBLIC_KEY=
PLUGIN_RELEASE_PUBLISHED_AT=
PLUGIN_RELEASE_MANIFEST_VERSION=2
PLUGIN_DESKTOP_RELEASE_URL=https://3dipl.org/plugin-releases/3DiPL-Asset-Manager-Desktop-Production-0.4.0.zip
PLUGIN_DESKTOP_RELEASE_SHA256=
PLUGIN_DESKTOP_RELEASE_SIGNATURE=
PLUGIN_DESKTOP_RELEASE_PUBLISHED_AT=
PLUGIN_DESKTOP_RELEASE_PROTOCOL_MINIMUM=2
PLUGIN_DESKTOP_RELEASE_PROTOCOL_MAXIMUM=2
PLUGIN_MAX_BRIDGE_RELEASE_URL=https://3dipl.org/plugin-releases/3DiPL-Asset-Manager-Production-0.4.0.mzp
PLUGIN_MAX_BRIDGE_RELEASE_SHA256=
PLUGIN_MAX_BRIDGE_RELEASE_SIGNATURE=
PLUGIN_MAX_BRIDGE_RELEASE_PUBLISHED_AT=
PLUGIN_MAX_BRIDGE_RELEASE_PROTOCOL_MINIMUM=2
PLUGIN_MAX_BRIDGE_RELEASE_PROTOCOL_MAXIMUM=2

MARKETPLACE_IMAGE_SEARCH_REQUIRED=false
MARKETPLACE_IMAGE_SEARCH_URL=
MARKETPLACE_IMAGE_SEARCH_API_KEY=
