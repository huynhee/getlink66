NODE_ENV=production
PLUGIN_DEPLOYMENT_ENV=staging
PORT=5000
CLIENT_URL=https://staging.3dipl.org
PUBLIC_BASE_URL=https://staging.3dipl.org
TRUST_PROXY=true

# Staging-only data and credentials. Never reuse Production values.
MONGO_CORE_URI=mongodb://mongo-staging:27017/3dipl_staging_core?replicaSet=rs0
MONGO_MARKETPLACE_URI=mongodb://mongo-staging:27017/3dipl_staging_marketplace?replicaSet=rs0
MONGO_MARKETPLACE_TRANSACTIONS_REQUIRED=true
MARKETPLACE_DB_TARGET=vps

PLUGIN_API_ENABLED=true
PLUGIN_JWT_SECRET=replace-with-a-separate-48-plus-character-staging-secret
PLUGIN_DOWNLOAD_CHALLENGE_MODE=risk
PLUGIN_QA_RISK_SECRET=replace-with-staging-only-qa-secret
PLUGIN_RELEASE_CHANNEL=staging
PLUGIN_RELEASE_VERSION=0.2.1
PLUGIN_MINIMUM_VERSION=0.2.0
PLUGIN_RELEASE_URL=https://staging.3dipl.org/plugin-releases/3DiPL-Asset-Manager-Staging-0.2.1.mzp
PLUGIN_RELEASE_SHA256=
PLUGIN_RELEASE_SIGNATURE=
PLUGIN_RELEASE_PUBLIC_KEY=
PLUGIN_RELEASE_PUBLISHED_AT=

ALLOW_DEV_LOGIN=false
ALLOW_DEV_ADMIN_LOGIN=false
THREED66_MOCK=false
MARKETPLACE_STARTUP_MIGRATIONS_ENABLED=false
SEPAY_ENABLED=false

# Supply real staging Turnstile credentials; never use production payment credentials.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=staging.3dipl.org
TURNSTILE_EXPECTED_ACTION=marketplace_download
