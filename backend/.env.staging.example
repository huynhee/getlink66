NODE_ENV=production
PLUGIN_DEPLOYMENT_ENV=staging
PORT=5000
CLIENT_URL=https://staging.3dipl.org
PUBLIC_BASE_URL=https://staging.3dipl.org
TRUST_PROXY=true

# Staging-only data and credentials. Never reuse Production values.
MONGO_CORE_URI=mongodb://mongo-staging:27017/3dipl_staging_core?replicaSet=rs0
MONGO_MARKETPLACE_URI=mongodb://mongo-staging:27017/3dipl_staging_marketplace?replicaSet=rs0
MONGO_MARKETPLACE_TRANSACTIONS_REQUIRED=true
MARKETPLACE_DB_TARGET=vps

PLUGIN_API_ENABLED=true
PLUGIN_RELEASE_ENABLED=false
PLUGIN_JWT_SECRET=replace-with-a-separate-48-plus-character-staging-secret
PLUGIN_DOWNLOAD_CHALLENGE_MODE=risk
PLUGIN_QA_RISK_SECRET=replace-with-staging-only-qa-secret
PLUGIN_RELEASE_CHANNEL=staging
PLUGIN_RELEASE_VERSION=0.4.0
PLUGIN_MINIMUM_VERSION=0.2.0
PLUGIN_RELEASE_URL=https://staging.3dipl.org/plugin-releases/3DiPL-Asset-Manager-Staging-0.4.0.mzp
PLUGIN_RELEASE_SHA256=
PLUGIN_RELEASE_SIGNATURE=
PLUGIN_RELEASE_PUBLIC_KEY=
PLUGIN_RELEASE_PUBLISHED_AT=
PLUGIN_RELEASE_MANIFEST_VERSION=2
PLUGIN_DESKTOP_RELEASE_URL=https://staging.3dipl.org/plugin-releases/3DiPL-Asset-Manager-Desktop-Staging-0.4.0.zip
PLUGIN_DESKTOP_RELEASE_SHA256=
PLUGIN_DESKTOP_RELEASE_SIGNATURE=
PLUGIN_DESKTOP_RELEASE_PUBLISHED_AT=
PLUGIN_DESKTOP_RELEASE_PROTOCOL_MINIMUM=2
PLUGIN_DESKTOP_RELEASE_PROTOCOL_MAXIMUM=2
PLUGIN_MAX_BRIDGE_RELEASE_URL=https://staging.3dipl.org/plugin-releases/3DiPL-Asset-Manager-Staging-0.4.0.mzp
PLUGIN_MAX_BRIDGE_RELEASE_SHA256=
PLUGIN_MAX_BRIDGE_RELEASE_SIGNATURE=
PLUGIN_MAX_BRIDGE_RELEASE_PUBLISHED_AT=
PLUGIN_MAX_BRIDGE_RELEASE_PROTOCOL_MINIMUM=2
PLUGIN_MAX_BRIDGE_RELEASE_PROTOCOL_MAXIMUM=2

ALLOW_DEV_LOGIN=false
ALLOW_DEV_ADMIN_LOGIN=false
THREED66_MOCK=false
MARKETPLACE_STARTUP_MIGRATIONS_ENABLED=false
SEPAY_ENABLED=false
MARKETPLACE_SEARCH_ENGINE=mongo
MARKETPLACE_MEILI_ROLLOUT_PERCENT=0
MARKETPLACE_MEILI_SHADOW_ENABLED=true
MARKETPLACE_SEARCH_FALLBACK_LIMIT=240
MARKETPLACE_POPULARITY_WORKER_ENABLED=true
MARKETPLACE_POPULARITY_WORKER_INTERVAL_MS=600000
MARKETPLACE_IMAGE_SEARCH_REQUIRED=false

# Supply real staging Turnstile credentials; never use production payment credentials.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=staging.3dipl.org
TURNSTILE_EXPECTED_ACTION=marketplace_download
