{
  "name": "get-link-3d66-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.18 <21"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "env:check": "node scripts/env-check.js",
    "drive:auth": "node scripts/google-drive-auth.js",
    "drive:check": "node scripts/google-drive-check.js",
    "backup:databases": "node scripts/database-backup.js --database=all",
    "backup:core": "node scripts/database-backup.js --database=core",
    "backup:marketplace": "node scripts/database-backup.js --database=marketplace",
    "backup:verify": "node scripts/database-backup.js --verify --database=all",
    "restore:drill": "node scripts/restore-drill.js --database=all",
    "history:retention": "node scripts/run-history-retention.js",
    "storage:status": "node scripts/storage-status.js",
    "storage:retention:dry-run": "node scripts/apply-storage-retention-policy.js",
    "storage:retention:apply": "node scripts/apply-storage-retention-policy.js --execute",
    "marketplace:demo:purge": "node scripts/purge-marketplace-demo-assets.js",
    "data:split:dry-run": "node scripts/split-marketplace-databases.js",
    "data:split:execute": "node scripts/split-marketplace-databases.js --execute",
    "data:split:finalize": "node scripts/split-marketplace-databases.js --finalize",
    "marketplace:sort:dry-run": "node scripts/backfill-marketplace-title-sort.js",
    "marketplace:sort:backfill": "node scripts/backfill-marketplace-title-sort.js --execute",
    "marketplace:search:dry-run": "node scripts/backfill-marketplace-bilingual-search.js",
    "marketplace:search:execute": "node scripts/backfill-marketplace-bilingual-search.js --execute",
    "marketplace:search:verify": "node scripts/backfill-marketplace-bilingual-search.js --verify",
    "marketplace:asset:dry-run": "node scripts/marketplace-asset-migration.js",
    "marketplace:asset:execute": "node scripts/marketplace-asset-migration.js --execute",
    "marketplace:covers:dry-run": "node scripts/marketplace-cover-cache.js",
    "marketplace:covers:backfill": "node scripts/marketplace-cover-cache.js --execute",
    "marketplace:covers:verify": "node scripts/marketplace-cover-cache.js --verify",
    "marketplace:catalog:reset:dry-run": "node scripts/reset-marketplace-model-catalog.js",
    "marketplace:catalog:reset": "node scripts/reset-marketplace-model-catalog.js --execute --confirm=RESET_MODEL_CATALOG",
    "qa:smoke": "node scripts/qa-smoke.js",
    "test": "node --test"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.1",
    "otpauth": "^9.5.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.61.1",
    "qrcode": "^1.5.4",
    "sepay-pg-node": "^1.0.0",
    "sharp": "^0.34.3",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
