PORT=5000
# production khi deploy that, development khi chay local HTTP.
NODE_ENV=development
CLIENT_URL=http://localhost:5173
PUBLIC_BASE_URL=
APP_URL=
CORS_ORIGINS=

# =========================
# MongoDB: Atlas Core + marketplace VPS
# =========================
# Atlas Core. MONGO_URI remains a backward-compatible fallback for local use.
MONGO_URI=mongodb://127.0.0.1:27017/getlink_3d66
MONGO_CORE_URI=
# MongoDB on the VPS for marketplace catalog, quota, logs and fast-growing history.
# Leave empty locally to keep both domains in MONGO_CORE_URI/MONGO_URI.
MONGO_MARKETPLACE_URI=
MARKETPLACE_DB_TARGET=vps
# Exact-once download counters and daily quota grants require a replica set.
MONGO_MARKETPLACE_TRANSACTIONS_REQUIRED=true
MONGO_SERVER_SELECTION_TIMEOUT_MS=30000 # Cho phép Core/Atlas hoàn tất một lần failover ngắn.
MONGO_CONNECT_TIMEOUT_MS=10000 # Thời gian tối đa mở một kết nối TCP tới từng node Core.
MONGO_SOCKET_TIMEOUT_MS=60000 # Đóng socket Core không phản hồi sau thời gian này.
MONGO_MAX_POOL_SIZE=50 # Số kết nối Core tối đa trong pool.
MONGO_MIN_POOL_SIZE=5 # Số kết nối Core tối thiểu giữ sẵn.
MONGO_MARKETPLACE_SERVER_SELECTION_TIMEOUT_MS=30000
MONGO_MARKETPLACE_CONNECT_TIMEOUT_MS=10000
MONGO_MARKETPLACE_SOCKET_TIMEOUT_MS=60000
MONGO_MARKETPLACE_MAX_POOL_SIZE=50
MONGO_MARKETPLACE_MIN_POOL_SIZE=5
# Set only in the shell for the destructive final migration command:
# MIGRATION_CONFIRM=split-marketplace-data
# Production: moi secret ben duoi can ngau nhien va toi thieu 32 ky tu.
# SESSION_SECRET chi con la fallback local/legacy, khong nen dung chung trong production.
SESSION_SECRET=change-me
JWT_SECRET=change-me-32-characters-minimum-jwt
# false: chi rang buoc JWT voi trinh duyet, phu hop user mang di dong/VPN doi IP.
# true: rang buoc them IP, chat hon nhung user doi mang se bi dang xuat.
SESSION_FINGERPRINT_BIND_IP=false
# false: fingerprint thay doi thi xoay token moi, khong dang xuat user.
# true: fingerprint thay doi thi bat dang nhap lai. Chi bat neu chap nhan false-positive.
SESSION_FINGERPRINT_ENFORCE=false
CSRF_HMAC_SECRET=change-me-32-characters-minimum-csrf
COOKIE_SIGNATURE_SECRET=change-me-32-characters-minimum-cookie
DOWNLOAD_TOKEN_SECRET=change-me-32-characters-minimum-download
COOKIE_ENCRYPTION_KEY=change-me-32-characters-minimum-encryption
ADMIN_EMAILS=huylevan696@gmail.com
TRUST_PROXY=false
JSON_BODY_LIMIT=100kb
LOG_LEVEL=info
RATE_LIMIT_MAX_BUCKETS=10000
# Cua so TOTP 2 nghia la chap nhan ma hien tai va lech toi da 60 giay.
TWO_FA_TOTP_WINDOW=2
# Login va setup 2FA dung bucket rieng de cac thiet bi admin khong tranh retry cua nhau.
TWO_FA_VERIFY_RATE_WINDOW_MS=300000
TWO_FA_VERIFY_RATE_LIMIT=20
TWO_FA_SETUP_RATE_WINDOW_MS=600000
TWO_FA_SETUP_RATE_LIMIT=10
# Tran theo IP dat cao de chan bot nhung van phu hop mang NAT nhieu user.
GETLINK_PREVIEW_IP_RATE_LIMIT=180
GETLINK_CREATE_IP_RATE_LIMIT=60
GETLINK_JOB_ENABLED=true
GETLINK_JOB_POLL_INTERVAL_MS=1000
GETLINK_JOB_STALE_MS=1800000
GETLINK_JOB_MAX_ATTEMPTS=3
TOPUP_CREATE_IP_RATE_LIMIT=100
MIN_TOPUP_AMOUNT=1000
MAX_MANUAL_CREDIT=1000000
MAX_STORED_CREDIT=10000000
MAX_VOUCHER_DISCOUNT_PERCENT=90
# Bat buoc set trong production de tranh Host header injection khi sinh download URL.
# Vi du: PUBLIC_BASE_URL=https://api.your-domain.com
# Neu de trong, backend fallback ve req.protocol + Host header (chi an toan trong dev/local).
ALLOW_MEMORY_DB=false
THREED66_MOCK=true
THREED66_DOWNLOAD_ENDPOINT=https://user.3d66.com/api/v1/download/handle
THREED66_DOWNLOAD_POP_ENDPOINT=https://user.3d66.com/api/v1/download/pop
THREED66_ORIGIN=https://su.3d66.com
THREED66_TIMEOUT_MS=30000
THREED66_REQUEST_INTERVAL_MS=3000
THREED66_PREVIEW_CONCURRENCY=2
THREED66_REFRESH_CONCURRENCY=2
THREED66_PREVIEW_QUEUE_MAX=200
THREED66_REFRESH_QUEUE_MAX=200
THREED66_ACCOUNT_SEARCH_ENABLED=true # Chỉ lấy modelId từ link user, rồi gọi search/checkKeyword bằng cookie 3D66 để tạo context sạch.
THREED66_MODEL_RESOLVE_MODE=search # search: tìm bằng ID; footprint: preview link gốc, download lấy URL từ lịch sử truy cập; direct: dùng URL đầu vào.
THREED66_RENDERER_TYPE=4
THREED66_FORMAT_VERSION=max2018
THREED66_PAYTYPE_VALUE=4
THREED66_FOOTPRINT_REFRESH_ATTEMPTS=4 # Số lần đọc/F5 lịch sử truy cập để chờ model vừa mở xuất hiện.
THREED66_FOOTPRINT_REFRESH_DELAY_MS=1500 # Thời gian chờ giữa các lần F5 lịch sử truy cập, ms.
THREED66_BROWSER_HEADLESS=true
THREED66_BROWSER_CONCURRENCY=1
THREED66_BROWSER_QUEUE_MAX=50
THREED66_BROWSER_MAX_TASKS=100
THREED66_BROWSER_MAX_AGE_MS=1800000
THREED66_BROWSER_ALWAYS=false
THREED66_DISABLE_BROWSER_PAGE_FALLBACK=false
THREED66_BROWSER_BLOCK_ASSETS=true
THREED66_BROWSER_WAIT_UNTIL=commit
THREED66_BROWSER_NAV_RETRIES=2
THREED66_BROWSER_RETRY_DELAY_MS=1200
THREED66_BROWSER_POST_COMMIT_WAIT_MS=1200
THREED66_BROWSER_WAIT_NETWORKIDLE=false
THREED66_DISABLE_BROWSER_DOWNLOAD_FALLBACK=false
THREED66_DOWNLOAD_HANDLE_BROWSER_FALLBACK=false
THREED66_DOWNLOAD_SEND_ORIGIN=false
THREED66_ACCOUNT_ID=177536980
THREED66_ACCOUNT_MARKER=
THREED66_MODEL_ID_BASE_URL=
THREED66_PROXY_ENABLED=false
THREED66_PROXY_URL=
THREED66_PROXY_FOR_PREVIEW=false
THREED66_PROXY_FOR_API=false
THREED66_PROXY_FOR_DOWNLOAD=false
THREED66_PROXY_FOR_BROWSER=false
THREED66_PROXY_FAIL_CLOSED=false
THREED66_COOKIE_MAX_FAILURES=2
THREED66_COOKIE_COOLDOWN_MS=1800000
THREED66_SITE_CONTEXTS=
VND_PER_CNY=4000
WEB_CREDIT_PER_CNY=10
REFERRAL_REWARD_CREDIT=28
GETLINK_REDOWNLOAD_DAYS=3
GETLINK_REDOWNLOAD_LIMIT=5
MAX_DOWNLOADS_PER_USER=2
MAX_DOWNLOADS_PER_IP=4
MAX_GLOBAL_DOWNLOADS=20
THREED66_GETLINK_CONCURRENCY=1
THREED66_GETLINK_QUEUE_MAX=200
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Login callback. This is separate from GOOGLE_DRIVE_OAUTH_REDIRECT_URI.
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Local-only login shortcut for marketplace/admin testing. Never enable in production.
ALLOW_DEV_LOGIN=false
ALLOW_DEV_ADMIN_LOGIN=false
DEV_LOGIN_EMAIL=dev@local.test
DEV_LOGIN_NAME=Local Dev
DEV_LOGIN_ROLE=user
DEV_LOGIN_PRO=false
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
VIETQR_TEMPLATE=compact2
VIETQR_IMAGE_HOST=https://api.vietqr.io/image
VIETQR_IMAGE_EXT=jpg
VIETQR_WEBHOOK_SECRET=change-me
# Allowlist IP nha cung cap webhook (comma-separated). Neu de rong + REQUIRE_IP_ALLOWLIST=false
# thi cho phep moi IP (van bao ve boi HMAC secret).
VIETQR_WEBHOOK_IPS=
# Nen bat trong production: neu IPS rong se REJECT 503 thay vi pass-through.
VIETQR_WEBHOOK_REQUIRE_IP_ALLOWLIST=false

# =========================
# Sepay payment
# =========================
SEPAY_ENABLED=true
# sandbox khi test, production khi go-live tren my.sepay.vn.
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=
# Dung chung de ky checkout va xac thuc IPN header X-Secret-Key.
SEPAY_SECRET_KEY=
SEPAY_PAYMENT_METHOD=BANK_TRANSFER
SEPAY_SUCCESS_URL=http://localhost:5173/topup?payment=success
SEPAY_ERROR_URL=http://localhost:5173/topup?payment=error
SEPAY_CANCEL_URL=http://localhost:5173/topup?payment=cancel
SEPAY_MEMBERSHIP_SUCCESS_URL=http://localhost:5173/membership?payment=success
SEPAY_MEMBERSHIP_ERROR_URL=http://localhost:5173/membership?payment=error
SEPAY_MEMBERSHIP_CANCEL_URL=http://localhost:5173/membership?payment=cancel
# Cau hinh tren SePay dashboard:
# IPN URL = https://<api-domain>/api/payments/sepay/ipn

# Versioned one-time migration for the five official Credit packages.
# Admin edits remain intact after the current revision has been applied.
TOPUP_PACKAGE_CATALOG_MIGRATION_ENABLED=true
SYNC_DEFAULT_MEMBERSHIP_PLANS=false

# Telegram notifications. Tao bot bang @BotFather, lay chat id cua admin/group roi dien vao.
# De trong thi backend bo qua, khong anh huong luong chinh.
TELEGRAM_NOTIFICATIONS_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Chong spam khi tat ca cookie 3D66 loi/cooldown. Mac dinh 30 phut.
TELEGRAM_COOKIE_ALERT_COOLDOWN_MS=1800000
# Chong gui lap thong bao Telegram giong nhau. Mac dinh 60 giay.
TELEGRAM_DEDUP_WINDOW_MS=60000

# =========================
# Marketplace Google Drive storage
# =========================
# Backend stream preview/file model bang Drive API, frontend/plugin khong nhin thay link Drive that.
# Khuyen nghi production: dung refresh token de backend tu cap access token moi.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Callback local cho lenh `npm run drive:auth`. Phai them dung URI nay vao OAuth Client.
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=http://127.0.0.1:53682/oauth2/callback
# Access token chi nen dung test local vi thuong het han sau khoang 1 gio.
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_BEARER_TOKEN=
# Only used when storageProvider=local. Leave empty for Drive production storage.
MARKETPLACE_LOCAL_STORAGE_ROOT=
MARKETPLACE_DRIVE_ROOT_FOLDER_ID=
MARKETPLACE_DRIVE_BACKUP_FOLDER_ID=
SCENES_DRIVE_ROOT_FOLDER_ID=
SCENES_DRIVE_BACKUP_FOLDER_ID=
# Parent folder for verified history archives. The worker creates
# getlink/YYYY-MM and marketplace-download/YYYY-MM below this folder.
HISTORY_ARCHIVE_DRIVE_FOLDER_ID=
HISTORY_RETENTION_JOB_ENABLED=true
HISTORY_RETENTION_RUN_ON_START=false
MARKETPLACE_QUOTA_GRANT_JOB_ENABLED=true
MARKETPLACE_QUOTA_GRANT_INTERVAL_MS=60000
# Keep both false until the metadata V2 dry-run and backup have been reviewed.
MARKETPLACE_DRIVE_WRITE_ENABLED=false
MARKETPLACE_DRIVE_CHANGES_ENABLED=false
MARKETPLACE_DRIVE_CHANGES_POLL_SECONDS=120
MARKETPLACE_DRIVE_CHANGES_BATCH_SIZE=100
MARKETPLACE_DRIVE_QUEUE_BATCH_SIZE=20
MARKETPLACE_DRIVE_QUEUE_MAX_ATTEMPTS=8
MARKETPLACE_DRIVE_QUEUE_RETRY_BASE_SECONDS=30

# Model downloads: "proxy" streams through the backend; "drive_redirect" sends
# the browser to Drive's webContentLink after permission/quota verification.
MARKETPLACE_DOWNLOAD_DELIVERY=drive_redirect
MARKETPLACE_DOWNLOAD_REDIRECT_FALLBACK_PROXY=true

# Cloudflare Turnstile. The keys below are official localhost test keys.
# Replace both keys in production and set the production hostname/action checks.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=

# =========================
# Marketplace image similarity
# =========================
# HTTP service must return { matches: [{ modelId, score }] } using source.modelId values.
MARKETPLACE_IMAGE_SEARCH_URL=
MARKETPLACE_IMAGE_SEARCH_API_KEY=
MARKETPLACE_IMAGE_SEARCH_TIMEOUT_MS=20000

# =========================
# Marketplace semantic discovery
# =========================
# Recommended production stack: SigLIP 2 embeddings + Qdrant dense/sparse hybrid search.
# When URL is empty, the API falls back to local catalog/content ranking automatically.
# Provider contract:
# POST /search          -> { matches: [{ modelId, score }], provider }
# POST /recommendations -> { matches: [{ modelId, score }], provider }
# POST /assets/upsert   -> index one namespaced Model/Scene document
# POST /assets/delete   -> remove one namespaced Model/Scene document
MARKETPLACE_DISCOVERY_URL=
MARKETPLACE_DISCOVERY_API_KEY=
MARKETPLACE_DISCOVERY_TIMEOUT_MS=8000
MARKETPLACE_DISCOVERY_UPSERT_PATH=/assets/upsert
MARKETPLACE_DISCOVERY_DELETE_PATH=/assets/delete
MARKETPLACE_DISCOVERY_SYNC_INTERVAL_MS=30000
MARKETPLACE_DISCOVERY_SYNC_BATCH_SIZE=20

# MongoDB VPS hybrid bilingual search with typo-tolerant token fallback.
MARKETPLACE_BILINGUAL_SEARCH_ENABLED=true
MARKETPLACE_SEARCH_INDEX_INTERVAL_MS=30000
MARKETPLACE_SEARCH_INDEX_BATCH_SIZE=100
MARKETPLACE_SEARCH_CANDIDATE_LIMIT=2000

# Dev only: create 61 sample Models and 18 sample Scenes at backend startup.
