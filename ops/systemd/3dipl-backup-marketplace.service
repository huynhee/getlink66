[Unit]
Description=3DIPL marketplace VPS encrypted backup
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=oneshot
User=3dipl
Group=3dipl
WorkingDirectory=/opt/3dipl
EnvironmentFile=/etc/3dipl/backend.env
ExecStart=/usr/bin/npm run backup:marketplace
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
