[Unit]
Description=Verify latest 3DIPL Drive database backups
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/3dipl/app
ExecStart=/usr/bin/docker compose -f compose.production.yml run --rm backend npm run backup:verify
TimeoutStartSec=6h
Nice=10
PrivateTmp=true
